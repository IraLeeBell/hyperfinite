{
  "apiVersion": "agentic-framework.github.com/v1alpha1",
  "kind": "DomainPackPolicy",
  "id": "marketing",
  "version": "1.0.0",
  "allowedCapabilities": [
    "marketing.frame-initiative@1.0.0",
    "marketing.create-repository-artifacts@1.0.0",
    "marketing.review-repository-artifacts@1.0.0",
    "core.refuse-authority-escalation@1.0.0"
  ],
  "prohibitedEffects": ["approve", "merge", "deploy", "publish", "external-publication", "production-mutation", "crm-mutation", "erp-mutation", "payment", "license-change", "visibility-change", "cms-mutation", "email-send", "social-post", "ads-mutation", "customer-communication"],
  "depthCeiling": "D1",
  "riskCeiling": "high",
  "privacyCeiling": "confidential",
  "maxCalls": 4,
  "maxCostUnits": 40,
  "maxLoops": 1,
  "maxRetries": 1,
  "maxParallel": 1
}
