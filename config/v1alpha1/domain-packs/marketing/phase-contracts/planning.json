  "outputSchema": { "type": "object", "additionalProperties": false, "required": ["steps", "targetSlots", "verificationIds"], "properties": { "steps": { "type": "array", "items": { "type": "string" } }, "targetSlots": { "type": "array", "items": { "type": "string" } }, "verificationIds": { "type": "array", "items": { "type": "string" } } } },
  "exitRules": [{ "predicate": "eligible-human-accepts-plan", "event": "execution-authorized" }],
  "limits": { "maxLoops": 1, "maxCalls": 0, "maxCostUnits": 0, "maxParallel": 1 },
  "humanGates": ["accept-plan"],
  "privacy": { "maximumClass": "internal", "retentionDays": 90 }
}
