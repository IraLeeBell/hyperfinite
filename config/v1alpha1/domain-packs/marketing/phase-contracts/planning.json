{
  "apiVersion": "agentic-framework.github.com/v1alpha1",
  "kind": "PhaseContract",
  "identity": { "id": "marketing.planning", "version": "1.0.0" },
  "phase": "planning",
  "compatibleLifecycle": "1.0.0",
