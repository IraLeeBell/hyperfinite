{
  "apiVersion": "agentic-framework.github.com/v1alpha1",
  "kind": "PhaseContract",
  "identity": { "id": "demo.app-modernization.verification", "version": "1.0.0" },
  "phase": "verification",
  "compatibleLifecycle": "1.0.0",
  "compatibleLifecycleDigest": "sha256:a0e9a837deebca4a58058edc98d447b9d8295a65a55091fd79fe7c4e8e7ec78d",
  "entryPredicates": ["activation-lease-current", "work-accord-current"],
  "requiredEvidence": ["trusted-binding", "activation-lease"],
  "allowedCapabilities": ["demo.app-modernization.verification@1.0.0"],
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["headSha", "patchDigest"],
    "properties": {
      "headSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
      "patchDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
    }
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["summary", "findings", "openQuestions"],
    "properties": {
      "summary": { "type": "string", "maxLength": 8000 },
      "findings": { "type": "array", "items": { "type": "string" }, "maxItems": 100 },
      "openQuestions": { "type": "array", "items": { "type": "string" }, "maxItems": 20 }
    }
  },
  "exitRules": [
    { "predicate": "verification-evidence-passed", "event": "verification-passed" },
    { "predicate": "work-accord-current", "event": "replan-requested" }
  ],
  "limits": { "maxLoops": 2, "maxCalls": 1, "maxCostUnits": 20, "maxParallel": 1 },
  "humanGates": ["activate", "approve-current-head"],
  "privacy": { "maximumClass": "confidential", "retentionDays": 90 }
}
