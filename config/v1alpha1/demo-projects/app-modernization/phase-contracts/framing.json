{
  "apiVersion": "agentic-framework.github.com/v1alpha1",
  "kind": "PhaseContract",
  "identity": { "id": "demo.app-modernization.framing", "version": "1.0.0" },
  "phase": "framing",
  "compatibleLifecycle": "1.0.0",
  "compatibleLifecycleDigest": "sha256:a0e9a837deebca4a58058edc98d447b9d8295a65a55091fd79fe7c4e8e7ec78d",
  "entryPredicates": ["activation-lease-current", "work-accord-current"],
  "requiredEvidence": ["trusted-binding", "activation-lease"],
  "allowedCapabilities": [
    "demo.app-modernization.current-state-inventory@1.0.0",
    "demo.app-modernization.modernization-assessment@1.0.0",
    "demo.app-modernization.target-architecture@1.0.0"
  ],
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["evidence"],
    "properties": {
      "evidence": { "type": "array", "items": { "type": "string" }, "maxItems": 64 }
    }
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["summary", "findings", "openQuestions"],
    "properties": {
      "summary": { "type": "string", "maxLength": 8000 },
      "findings": { "type": "array", "items": { "type": "string" }, "maxItems": 100 },
      "openQuestions": { "type": "array", "items": { "type": "string" }, "maxItems": 20 }
    }
  },
  "exitRules": [
    { "predicate": "eligible-human-accepts-frame", "event": "frame-accepted" }
  ],
  "limits": { "maxLoops": 3, "maxCalls": 3, "maxCostUnits": 50, "maxParallel": 1 },
  "humanGates": ["activate", "accept-frame"],
  "privacy": { "maximumClass": "internal", "retentionDays": 90 }
}
