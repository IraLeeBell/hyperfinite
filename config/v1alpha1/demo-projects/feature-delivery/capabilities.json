      {
        "id": "demo.feature-delivery.build",
        "version": "1.0.0",
        "publisher": "agentic-framework",
        "owner": "framework-maintainers",
        "description": "Drafts content for approved logical slots without selecting paths, commands, targets, or effects.",
        "status": "active",
        "implementation": {
          "kind": "model",
          "provider": "configured-provider"
        },
        "allowedPhases": [
          "execution"
        ],
        "actorClasses": [
          "system"
        ],
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidence",
            "targetSlots",
            "maxPatchBytes"
          ],
          "properties": {
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "targetSlots": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,62}$"
              }
            },
            "maxPatchBytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary",
            "changes",
            "findings",
            "openQuestions",
            "result"
          ],
          "properties": {
            "summary": {
              "type": "string",
              "maxLength": 8000
            },
            "changes": {
              "type": "array",
              "maxItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "slot",
                  "content"
                ],
                "properties": {
                  "slot": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,62}$"
                  },
                  "content": {
                    "type": "string",
                    "maxLength": 32768
                  }
                }
              }
            },
            "findings": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 20
            },
            "openQuestions": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 20
            },
            "result": {
              "enum": [
                "drafted",
                "blocked",
                "failed"
              ]
            }
          }
        },
