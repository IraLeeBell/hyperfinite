{
  "apiVersion": "agentic-framework.github.com/v1alpha1",
  "kind": "PhaseContract",
  "identity": {
    "id": "adaptive-delivery.planning",
    "version": "1.0.0"
  },
  "phase": "planning",
  "compatibleLifecycle": "1.0.0",
  "compatibleLifecycleDigest": "sha256:a0e9a837deebca4a58058edc98d447b9d8295a65a55091fd79fe7c4e8e7ec78d",
  "entryPredicates": [
    "work-accord-current",
    "framing-artifacts-current"
  ],
  "requiredEvidence": [
    "trusted-binding",
    "accepted-frame"
  ],
  "allowedCapabilities": [],
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "featureBriefDigest",
      "impactDigest",
      "designDigest"
    ],
    "properties": {
      "featureBriefDigest": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "impactDigest": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "designDigest": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "implementationPlanDigest",
      "targetSlots",
      "verificationCommandIds"
    ],
    "properties": {
      "implementationPlanDigest": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "targetSlots": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$"
        }
      },
      "verificationCommandIds": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$"
        }
      }
    }
  },
  "exitRules": [
    {
      "predicate": "eligible-human-accepts-plan",
      "event": "execution-authorized"
    }
  ],
  "limits": {
    "maxLoops": 1,
    "maxCalls": 0,
    "maxCostUnits": 0,
    "maxParallel": 1
  },
  "humanGates": [
    "accept-plan"
  ],
  "privacy": {
    "maximumClass": "internal",
    "retentionDays": 90
  }
}
