{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-framework.github.com/schemas/reference-inventory.schema.json",
  "title": "Hyperfinite reference inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "references"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      }
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "canonical_url",
        "source_path",
        "revision",
        "dossier",
        "license",
        "copyright",
        "trademarks",
        "use",
        "material_claims",
        "uncertainties"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["repository", "website"]
        },
        "canonical_url": {
          "type": "string",
          "format": "uri"
        },
        "repository": {
          "type": ["string", "null"],
          "pattern": "^[^/]+/[^/]+$"
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "mutable_source": {
          "type": "boolean"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "corroborating_evidence_urls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "corroborating_source_path": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "dossier": {
          "type": "string",
          "pattern": "^docs/provenance/references/.+\\.md$"
        },
        "license": {
          "$ref": "#/$defs/license"
        },
        "copyright": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/copyright"
          }
        },
        "trademarks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trademark"
          }
        },
        "use": {
          "$ref": "#/$defs/use"
        },
        "review": {
          "$ref": "#/$defs/review"
        },
        "material_claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "repository"
              }
            }
          },
          "then": {
            "required": ["repository", "review"]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "website"
              }
            }
          },
          "then": {
            "required": [
              "mutable_source",
              "observed_at",
              "repository",
              "corroborating_source_path",
              "corroborating_evidence_urls",
              "review"
            ],
            "properties": {
              "mutable_source": {
                "const": true
              },
              "source_path": {
                "pattern": "^/"
              }
            }
          }
        }
      ]
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref_type",
        "tag",
        "commit_sha",
        "commit_url",
        "source_blob_sha",
        "committed_at",
        "retrieved_at"
      ],
      "properties": {
        "ref_type": {
          "description": "The authoritative reviewed ref type. Repository snapshots are always commit-pinned.",
          "enum": ["commit", "website-observation"]
        },
        "tag": {
          "description": "Observed release context, if any; never the authoritative provenance ref.",
          "type": ["string", "null"]
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "commit_url": {
          "type": "string",
          "format": "uri"
        },
        "source_blob_sha": {
          "description": "Git SHA-1 of the reviewed source blob at commit_sha.",
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "committed_at": {
          "type": "string",
          "format": "date-time"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spdx_expression",
        "evidence_url",
        "scope",
        "notice_requirements",
        "review_status"
      ],
      "properties": {
        "spdx_expression": {
          "type": "string",
          "minLength": 1
        },
        "evidence_url": {
          "type": ["string", "null"],
          "format": "uri"
        },
        "evidence_method": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "notice_requirements": {
          "type": "string",
          "minLength": 1
        },
        "review_status": {
          "enum": ["verified", "needs-human-review"]
        }
      }
    },
    "copyright": {
      "type": "object",
      "additionalProperties": false,
      "required": ["holder", "evidence_url"],
      "properties": {
        "holder": {
          "type": "string",
          "minLength": 1
        },
        "evidence_url": {
          "type": ["string", "null"],
          "format": "uri"
        },
        "evidence_method": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "trademark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "owner", "review_status"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "review_status": {
          "enum": ["observed", "needs-human-review"]
        }
      }
    },
    "use": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "concept_or_material_used",
        "local_destination",
        "modifications",
        "review_owner",
        "approval_status",
        "legal_review_status",
        "trademark_review_status",
        "security_review_status",
        "update_policy",
        "removal_or_replacement_plan",
        "legal_review_required"
      ],
      "properties": {
        "classification": {
          "enum": ["conceptual", "adapted", "verbatim", "none"]
        },
        "concept_or_material_used": {
          "type": "string",
          "minLength": 1
        },
        "local_destination": {
          "type": ["string", "null"]
        },
        "modifications": {
          "type": "string",
          "minLength": 1
        },
        "review_owner": {
          "type": "string",
          "minLength": 1
        },
        "approval_status": {
          "enum": ["approved-conceptual", "approved", "pending", "blocked"]
        },
        "legal_review_status": {
          "enum": ["not-required-for-conceptual", "needs-human-review", "approved"]
        },
        "trademark_review_status": {
          "enum": ["observed", "needs-human-review", "approved"]
        },
        "security_review_status": {
          "enum": ["reviewed-conceptual", "needs-human-review", "approved"]
        },
        "update_policy": {
          "type": "string",
          "minLength": 1
        },
        "removal_or_replacement_plan": {
          "type": "string",
          "minLength": 1
        },
        "legal_review_required": {
          "type": "boolean"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_hash", "review_link", "notes"],
      "properties": {
        "source_hash": {
          "description": "Algorithm-qualified Git SHA-1 for the same reviewed source object as revision.source_blob_sha.",
          "type": "string",
          "pattern": "^git-sha1:[0-9a-f]{40}$"
        },
        "review_link": {
          "type": "string",
          "pattern": "^docs/provenance/references/.+\\.md$"
        },
        "notes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "summary", "evidence_urls", "influence"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "evidence_urls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "influence": {
          "enum": ["factual-reference", "conceptual-influence", "non-adoption"]
        }
      }
    }
  }
}
