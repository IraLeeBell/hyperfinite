{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-framework.github.com/schemas/v1alpha1/phase-contract.schema.json",
  "title": "Phase Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "identity", "phase", "compatibleLifecycle", "compatibleLifecycleDigest", "entryPredicates", "requiredEvidence", "allowedCapabilities", "inputSchema", "outputSchema", "exitRules", "limits", "humanGates", "privacy"],
  "properties": {
    "apiVersion": { "const": "agentic-framework.github.com/v1alpha1" },
    "kind": { "const": "PhaseContract" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "phase": { "$ref": "#/$defs/activePhase" },
    "compatibleLifecycle": { "const": "1.0.0" },
    "compatibleLifecycleDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "entryPredicates": { "$ref": "#/$defs/strings" },
    "requiredEvidence": { "$ref": "#/$defs/strings" },
    "allowedCapabilities": { "$ref": "#/$defs/strings" },
    "inputSchema": { "type": "object" },
    "outputSchema": { "type": "object" },
    "exitRules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["predicate", "event"],
        "properties": {
          "predicate": { "type": "string", "minLength": 1 },
          "event": { "type": "string", "minLength": 1 }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxLoops", "maxCalls", "maxCostUnits", "maxParallel"],
      "properties": {
        "maxLoops": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "maxCalls": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "maxCostUnits": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "maxParallel": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "humanGates": { "$ref": "#/$defs/strings" },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumClass", "retentionDays"],
      "properties": {
        "maximumClass": { "enum": ["public", "internal", "confidential", "restricted"] },
        "retentionDays": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    }
  },
  "$defs": {
    "activePhase": {
      "enum": ["framing", "planning", "execution", "verification", "human-review"]
    },
    "strings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
