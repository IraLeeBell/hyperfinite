{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-framework.github.com/schemas/v1alpha1/activation-lease.schema.json",
  "title": "Activation Lease",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "id", "workAccordDigest", "approvedBy", "authorizationDigest", "allowedPhases", "allowedCapabilities", "maxCalls", "maxTokens", "maxCostUnits", "maxParallel", "expiresAt", "revoked"],
  "properties": {
    "apiVersion": { "const": "agentic-framework.github.com/v1alpha1" },
    "kind": { "const": "ActivationLease" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$" },
    "workAccordDigest": { "$ref": "#/$defs/digest" },
    "approvedBy": { "type": "string", "minLength": 1 },
    "authorizationDigest": { "$ref": "#/$defs/digest" },
    "allowedPhases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/activePhase" }
    },
    "allowedCapabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "maxCalls": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "maxTokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "maxCostUnits": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "maxParallel": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "expiresAt": { "type": "string", "format": "date-time" },
    "revoked": { "type": "boolean" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "activePhase": {
      "enum": ["framing", "planning", "execution", "verification", "human-review"]
    }
  }
}
