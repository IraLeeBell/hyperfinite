{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-framework.github.com/schemas/v1alpha1/demo-projects/security-dependency-remediation/synthetic-security-evidence.schema.json",
  "title": "Signed synthetic security evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "schemaVersion",
    "contentDigest",
    "spec",
    "signature"
  ],
  "properties": {
    "apiVersion": {
      "const": "agentic-framework.github.com/v1alpha1"
    },
    "kind": {
      "enum": [
        "SecurityRemediationSyntheticAdvisory",
        "SecurityRemediationSyntheticScannerEvidence"
      ]
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "contentDigest": {
      "$ref": "#/$defs/digest"
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "demoProjectId",
        "evidenceType",
        "evidenceId",
        "dependency",
        "affectedVersion",
        "fixedVersion",
        "headSha",
        "subjectDigest",
        "outcome",
        "findings",
        "observedAt",
        "expiresAt",
        "synthetic",
        "networkUsed"
      ],
      "properties": {
        "demoProjectId": {
          "const": "security-dependency-remediation"
        },
        "evidenceType": {
          "enum": [
            "advisory",
            "scanner"
          ]
        },
        "evidenceId": {
          "type": "string",
          "pattern": "^[A-Z0-9-]{3,64}$"
        },
        "dependency": {
          "const": "mist-lru"
        },
        "affectedVersion": {
          "const": "0.4.0"
        },
        "fixedVersion": {
          "const": "0.4.1"
        },
        "headSha": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "subjectDigest": {
          "$ref": "#/$defs/digest"
        },
        "outcome": {
          "enum": [
            "affected",
            "success"
          ]
        },
        "findings": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "synthetic": {
          "const": true
        },
        "networkUsed": {
          "const": false
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "keyId",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "ed25519"
        },
        "keyId": {
          "const": "security-remediation-synthetic-evidence-key"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]+={0,2}$",
          "minLength": 80,
          "maxLength": 128
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
