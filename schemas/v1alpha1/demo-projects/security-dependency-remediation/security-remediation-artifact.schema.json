{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-framework.github.com/schemas/v1alpha1/demo-projects/security-dependency-remediation/security-remediation-artifact.schema.json",
  "title": "Security and Dependency Remediation stage artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "schemaVersion",
    "contentDigest",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "agentic-framework.github.com/v1alpha1"
    },
    "kind": {
      "enum": [
        "SecurityRemediationBoundedReport",
        "SecurityRemediationAffectedComponentInventory",
        "SecurityRemediationReproductionEvidence",
        "SecurityRemediationImpactAssessment",
        "SecurityRemediationPlan",
        "SecurityRemediationDraftPatchPullRequestEvidence",
        "SecurityRemediationVerification",
        "SecurityRemediationHumanReviewPackage"
      ]
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "contentDigest": {
      "$ref": "#/$defs/digest"
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "demoProjectId",
        "stageId",
        "trustedBindingDigest",
        "subjectDigest",
        "headSha",
        "status",
        "assertions",
        "constraints",
        "externalCallCount"
      ],
      "properties": {
        "demoProjectId": {
          "const": "security-dependency-remediation"
        },
        "stageId": {
          "enum": [
            "triage",
            "reproduction-and-impact-analysis",
            "remediation-design",
            "patch-planning",
            "patch-implementation",
            "security-verification",
            "human-review"
          ]
        },
        "trustedBindingDigest": {
          "$ref": "#/$defs/digest"
        },
        "subjectDigest": {
          "$ref": "#/$defs/digest"
        },
        "headSha": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "draft",
            "verified",
            "waiting-human"
          ]
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "status",
              "evidenceDigest"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,127}$"
              },
              "status": {
                "enum": [
                  "success",
                  "information"
                ]
              },
              "evidenceDigest": {
                "$ref": "#/$defs/digest"
              }
            }
          }
        },
        "constraints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "externalCallCount": {
          "const": 0
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  }
}
