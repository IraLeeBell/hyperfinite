{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-framework.github.com/schemas/v1alpha1/demo-projects/security-dependency-remediation/scenario-fixtures.schema.json",
  "title": "Security and Dependency Remediation deterministic scenario fixtures",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "schemaVersion",
    "contentDigest",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "agentic-framework.github.com/v1alpha1"
    },
    "kind": {
      "enum": [
        "SecurityRemediationJourneyScenarios",
        "SecurityRemediationRecoveryScenarios",
        "SecurityRemediationAdversarialScenarios"
      ]
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "contentDigest": {
      "$ref": "#/$defs/digest"
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "demoProjectId",
        "scenarios"
      ],
      "properties": {
        "demoProjectId": {
          "const": "security-dependency-remediation"
        },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "input",
              "expectedAction",
              "expectedState",
              "inferenceAllowed",
              "effectAllowed",
              "externalCallCount"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,127}$"
              },
              "input": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "expectedAction": {
                "enum": [
                  "advance",
                  "wait-human",
                  "pause",
                  "block",
                  "cancel",
                  "repair",
                  "replan",
                  "revise",
                  "retry",
                  "reconcile",
                  "reauthorize",
                  "refuse"
                ]
              },
              "expectedState": {
                "enum": [
                  "ACTIVATION_PENDING",
                  "FRAMING",
                  "PLANNED",
                  "EXECUTING",
                  "VERIFYING",
                  "HUMAN_REVIEW",
                  "COMPLETED",
                  "PAUSED",
                  "BLOCKED",
                  "CANCELLED"
                ]
              },
              "inferenceAllowed": {
                "type": "boolean"
              },
              "effectAllowed": {
                "type": "boolean"
              },
              "externalCallCount": {
                "const": 0
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
