{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-framework.github.com/schemas/v1alpha1/demo-projects/feature-delivery/control-fixtures.schema.json",
  "title": "Feature Delivery trusted binding and control fixtures",
  "oneOf": [
    {
      "$ref": "#/$defs/trustedBinding"
    },
    {
      "$ref": "#/$defs/projectBinding"
    },
    {
      "$ref": "#/$defs/logicalTargets"
    },
    {
      "$ref": "#/$defs/verificationCommands"
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "header": {
      "type": "object",
      "required": [
        "apiVersion",
        "kind",
        "schemaVersion",
        "contentDigest",
        "spec"
      ]
    },
    "trustedBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "schemaVersion",
        "contentDigest",
        "spec"
      ],
      "properties": {
        "apiVersion": {
          "const": "agentic-framework.github.com/v1alpha1"
        },
        "kind": {
          "const": "FeatureDeliveryTrustedBinding"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "contentDigest": {
          "$ref": "#/$defs/digest"
        },
        "spec": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "synthetic",
            "demoProjectId",
            "repository",
            "workItem",
            "defaultRef",
            "baseSha",
            "allowedEvidencePaths",
            "observedPathsAreEvidenceOnly",
            "untrustedRepositoryHintsGrantAuthority"
          ],
          "properties": {
            "synthetic": {
              "const": true
            },
            "demoProjectId": {
              "const": "feature-delivery"
            },
            "repository": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "nodeId",
                "fullName",
                "rootId"
              ],
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1
                },
                "nodeId": {
                  "type": "string",
                  "minLength": 1
                },
                "fullName": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
                },
                "rootId": {
                  "$ref": "#/$defs/digest"
                }
              }
            },
            "workItem": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "number",
                "nodeId"
              ],
              "properties": {
                "number": {
                  "type": "integer",
                  "minimum": 1
                },
                "nodeId": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "defaultRef": {
              "const": "refs/heads/main"
            },
            "baseSha": {
              "$ref": "#/$defs/sha"
            },
            "allowedEvidencePaths": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "observedPathsAreEvidenceOnly": {
              "const": true
            },
            "untrustedRepositoryHintsGrantAuthority": {
              "const": false
            }
          }
        }
      }
    },
    "projectBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "schemaVersion",
        "contentDigest",
        "spec"
      ],
      "properties": {
        "apiVersion": {
          "const": "agentic-framework.github.com/v1alpha1"
        },
        "kind": {
          "const": "FeatureDeliveryProjectBinding"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "contentDigest": {
          "$ref": "#/$defs/digest"
        },
        "spec": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "synthetic",
            "demoProjectId",
            "ownerNodeId",
            "projectNodeId",
            "itemNodeId",
            "projectSchemaDigest",
            "projectionOnly",
            "administrativelyConfigured"
          ],
          "properties": {
            "synthetic": {
              "const": true
            },
            "demoProjectId": {
              "const": "feature-delivery"
            },
            "ownerNodeId": {
              "type": "string",
              "minLength": 1
            },
            "projectNodeId": {
              "type": "string",
              "minLength": 1
            },
            "itemNodeId": {
              "type": "string",
              "minLength": 1
            },
            "projectSchemaDigest": {
              "$ref": "#/$defs/digest"
            },
            "projectionOnly": {
              "const": true
            },
            "administrativelyConfigured": {
              "const": false
            }
          }
        }
      }
    },
    "logicalTargets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "schemaVersion",
        "contentDigest",
        "spec"
      ],
      "properties": {
        "apiVersion": {
          "const": "agentic-framework.github.com/v1alpha1"
        },
        "kind": {
          "const": "FeatureDeliveryLogicalTargetMap"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "contentDigest": {
          "$ref": "#/$defs/digest"
        },
        "spec": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "demoProjectId",
            "repositoryBindingDigest",
            "baseSha",
            "maxFiles",
            "maxPatchBytes",
            "targets"
          ],
          "properties": {
            "demoProjectId": {
              "const": "feature-delivery"
            },
            "repositoryBindingDigest": {
              "$ref": "#/$defs/digest"
            },
            "baseSha": {
              "$ref": "#/$defs/sha"
            },
            "maxFiles": {
              "const": 2
            },
            "maxPatchBytes": {
              "const": 65536
            },
            "targets": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "slot",
                  "path",
                  "operation",
                  "expectedDigest",
                  "expectedMode",
                  "maxBytes"
                ],
                "properties": {
                  "slot": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,62}$"
                  },
                  "path": {
                    "type": "string",
                    "pattern": "^examples/demos/feature-delivery/sandbox/"
                  },
                  "operation": {
                    "enum": [
                      "create",
                      "modify"
                    ]
                  },
                  "expectedDigest": {
                    "oneOf": [
                      {
                        "$ref": "#/$defs/digest"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "expectedMode": {
                    "const": "100644"
                  },
                  "maxBytes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 32768
                  }
                }
              }
            }
          }
        }
      }
    },
    "verificationCommands": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "schemaVersion",
        "contentDigest",
        "spec"
      ],
      "properties": {
        "apiVersion": {
          "const": "agentic-framework.github.com/v1alpha1"
        },
        "kind": {
          "const": "FeatureDeliveryVerificationCommandCatalog"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "contentDigest": {
          "$ref": "#/$defs/digest"
        },
        "spec": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "demoProjectId",
            "commands"
          ],
          "properties": {
            "demoProjectId": {
              "const": "feature-delivery"
            },
            "commands": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "purpose",
                  "executable",
                  "args",
                  "timeoutMs",
                  "maxOutputBytes"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,62}$"
                  },
                  "purpose": {
                    "enum": [
                      "acceptance",
                      "regression",
                      "integrity"
                    ]
                  },
                  "executable": {
                    "enum": [
                      "node",
                      "npm",
                      "git"
                    ]
                  },
                  "args": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[^;&|`\\n\\r]+$"
                    }
                  },
                  "timeoutMs": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 120000
                  },
                  "maxOutputBytes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65536
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
