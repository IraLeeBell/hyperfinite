{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-framework.github.com/schemas/v1alpha1/demo-projects/feature-delivery/implementation-plan.schema.json",
  "title": "Feature Delivery deterministic implementation plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "schemaVersion",
    "contentDigest",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "agentic-framework.github.com/v1alpha1"
    },
    "kind": {
      "const": "FeatureDeliveryImplementationPlan"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "contentDigest": {
      "$ref": "#/$defs/digest"
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "solutionDesignDigest",
        "deterministic",
        "maxPatchBytes",
        "nodes"
      ],
      "properties": {
        "solutionDesignDigest": {
          "$ref": "#/$defs/digest"
        },
        "deterministic": {
          "const": true
        },
        "maxPatchBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "dependsOn",
              "logicalSlots",
              "acceptanceCriterionIds",
              "verificationCommandIds"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^FD-PLAN-[0-9]{3}$"
              },
              "dependsOn": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^FD-PLAN-[0-9]{3}$"
                }
              },
              "logicalSlots": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,62}$"
                }
              },
              "acceptanceCriterionIds": {
                "$ref": "#/$defs/acceptanceIds"
              },
              "verificationCommandIds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,62}$"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "acceptanceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^FD-AC-[0-9]{3}$"
      }
    }
  }
}
