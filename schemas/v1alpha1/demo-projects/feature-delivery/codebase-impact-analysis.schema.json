{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-framework.github.com/schemas/v1alpha1/demo-projects/feature-delivery/codebase-impact-analysis.schema.json",
  "title": "Feature Delivery codebase impact analysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "schemaVersion",
    "contentDigest",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "agentic-framework.github.com/v1alpha1"
    },
    "kind": {
      "const": "FeatureDeliveryCodebaseImpactAnalysis"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "contentDigest": {
      "$ref": "#/$defs/digest"
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "featureBriefDigest",
        "repositoryBindingDigest",
        "baseSha",
        "observedPaths",
        "observedPathsAreEvidenceOnly",
        "promptInjectionFindings",
        "acceptanceCriterionIds"
      ],
      "properties": {
        "featureBriefDigest": {
          "$ref": "#/$defs/digest"
        },
        "repositoryBindingDigest": {
          "$ref": "#/$defs/digest"
        },
        "baseSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "observedPaths": {
          "$ref": "#/$defs/strings"
        },
        "observedPathsAreEvidenceOnly": {
          "const": true
        },
        "promptInjectionFindings": {
          "$ref": "#/$defs/strings"
        },
        "acceptanceCriterionIds": {
          "$ref": "#/$defs/acceptanceIds"
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "strings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptanceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^FD-AC-[0-9]{3}$"
      }
    }
  }
}
