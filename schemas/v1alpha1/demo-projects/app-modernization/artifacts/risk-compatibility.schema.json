{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-framework.github.com/schemas/v1alpha1/demo-projects/app-modernization/artifacts/risk-compatibility.schema.json",
  "title": "App Modernization risk and compatibility report",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "schemaVersion", "contentDigest", "spec"],
  "properties": {
    "apiVersion": { "const": "agentic-framework.github.com/v1alpha1" },
    "kind": { "const": "AppModernizationRiskCompatibilityReport" },
    "schemaVersion": { "const": "1.0.0" },
    "contentDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessmentDigest", "risks", "compatibility", "productionChangeAuthorized"],
      "properties": {
        "assessmentDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "risks": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "category", "likelihood", "impact", "mitigation", "evidenceDigest"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
              "category": { "enum": ["architecture", "data", "dependency", "security", "operations", "delivery"] },
              "likelihood": { "enum": ["low", "moderate", "high"] },
              "impact": { "enum": ["low", "moderate", "high"] },
              "mitigation": { "type": "string", "minLength": 1, "maxLength": 512 },
              "evidenceDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
            }
          }
        },
        "compatibility": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target", "status", "evidenceDigest"],
            "properties": {
              "target": { "type": "string", "minLength": 1, "maxLength": 128 },
              "status": { "enum": ["compatible", "conditional", "incompatible", "unknown"] },
              "evidenceDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
            }
          }
        },
        "productionChangeAuthorized": { "const": false }
      }
    }
  }
}
