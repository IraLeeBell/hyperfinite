{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-framework.github.com/schemas/v1alpha1/demo-projects/app-modernization/artifacts/target-architecture.schema.json",
  "title": "App Modernization target architecture",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "schemaVersion", "contentDigest", "spec"],
  "properties": {
    "apiVersion": { "const": "agentic-framework.github.com/v1alpha1" },
    "kind": { "const": "AppModernizationTargetArchitecture" },
    "schemaVersion": { "const": "1.0.0" },
    "contentDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessmentDigest", "riskCompatibilityDigest", "principles", "components", "decisions", "nonGoals"],
      "properties": {
        "assessmentDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "riskCompatibilityDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "principles": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
        "components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "responsibility", "interfaces"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
              "responsibility": { "type": "string", "minLength": 1, "maxLength": 512 },
              "interfaces": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } }
            }
          }
        },
        "decisions": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
        "nonGoals": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 512 } }
      }
    }
  }
}
