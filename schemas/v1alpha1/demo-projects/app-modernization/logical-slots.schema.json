{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-framework.github.com/schemas/v1alpha1/demo-projects/app-modernization/logical-slots.schema.json",
  "title": "Trusted App Modernization logical slot map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "slots"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "slots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "relativePath", "maxBytes", "required"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
          "relativePath": { "type": "string", "pattern": "^(?!.*(?:^|/)\\.\\.?(?:/|$))(?:src|tests|docs)/[A-Za-z0-9._/-]+$" },
          "maxBytes": { "type": "integer", "minimum": 1, "maximum": 65536 },
          "required": { "type": "boolean" }
        }
      }
    }
  }
}
