{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-framework.github.com/schemas/v1alpha1/audit-event.schema.json",
  "title": "Audit event",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "schemaVersion", "sequence", "occurredAt", "component", "action", "outcome", "reasonCode", "authorityDigest", "subjectDigest", "previousEventDigest", "usage"],
  "properties": {
    "apiVersion": { "const": "agentic-framework.github.com/v1alpha1" },
    "kind": { "const": "AuditEvent" },
    "schemaVersion": { "const": "1.0.0" },
    "sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "occurredAt": { "type": "string", "format": "date-time", "maxLength": 24 },
    "component": { "enum": ["lifecycle", "policy", "kernel", "adapter", "single-writer", "runtime", "domain-pack"] },
    "action": { "enum": ["authorize", "transition", "invoke-model", "invoke-tool", "plan-effect", "apply-effect", "reconcile", "human-gate", "reserve-budget", "release-budget"] },
    "outcome": { "enum": ["accepted", "refused", "partial"] },
    "reasonCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
    "authorityDigest": { "$ref": "#/$defs/digest" },
    "subjectDigest": { "$ref": "#/$defs/digest" },
    "previousEventDigest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempts", "tokens", "costUnits", "toolCalls", "effects", "durationMs"],
      "properties": {
        "attempts": { "$ref": "#/$defs/counter" },
        "tokens": { "$ref": "#/$defs/counter" },
        "costUnits": { "$ref": "#/$defs/counter" },
        "toolCalls": { "$ref": "#/$defs/counter" },
        "effects": { "$ref": "#/$defs/counter" },
        "durationMs": { "$ref": "#/$defs/counter" }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "counter": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
  }
}
