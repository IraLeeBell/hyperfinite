{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-framework.github.com/schemas/v1alpha1/domain-pack-policy.schema.json",
  "title": "Domain Pack policy constraints",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "id", "version", "allowedCapabilities", "prohibitedEffects", "depthCeiling", "riskCeiling", "privacyCeiling", "maxCalls", "maxCostUnits", "maxLoops", "maxRetries", "maxParallel"],
  "properties": {
    "apiVersion": { "const": "agentic-framework.github.com/v1alpha1" },
    "kind": { "const": "DomainPackPolicy" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "allowedCapabilities": { "$ref": "#/$defs/strings" },
    "prohibitedEffects": { "$ref": "#/$defs/strings" },
    "depthCeiling": { "enum": ["D0", "D1", "D2", "D3"] },
    "riskCeiling": { "enum": ["low", "moderate", "high", "critical"] },
    "privacyCeiling": { "enum": ["public", "internal", "confidential", "restricted"] },
    "maxCalls": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "maxCostUnits": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "maxLoops": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "maxRetries": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "maxParallel": { "type": "integer", "minimum": 1, "maximum": 32 }
  },
  "$defs": {
    "strings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
