{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-framework.github.com/schemas/v1alpha1/trusted-validated-patch-artifact.schema.json",
  "title": "Trusted validated patch artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "authorizationDigest",
    "contractRevision",
    "repositoryId",
    "workItemNodeId",
    "baseSha",
    "planningArtifactDigest",
    "executionGrantDigest",
    "modelOutputDigest",
    "threatEvidenceDigest",
    "kernelReceiptDigest",
    "kernelProofDigest",
    "patch",
    "patchDigest",
    "treeDigest",
    "gitTreeSha",
    "files",
    "verification",
    "createdAt",
    "expiresAt",
    "signature"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "authorizationDigest": { "$ref": "#/$defs/digest" },
    "contractRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "repositoryId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "workItemNodeId": { "type": "string", "minLength": 1 },
    "baseSha": { "$ref": "#/$defs/sha" },
    "planningArtifactDigest": { "$ref": "#/$defs/digest" },
    "executionGrantDigest": { "$ref": "#/$defs/digest" },
    "modelOutputDigest": { "$ref": "#/$defs/digest" },
    "threatEvidenceDigest": { "$ref": "#/$defs/digest" },
    "kernelReceiptDigest": { "$ref": "#/$defs/digest" },
    "kernelProofDigest": { "$ref": "#/$defs/digest" },
    "patch": { "type": "string", "minLength": 1 },
    "patchDigest": { "$ref": "#/$defs/digest" },
    "treeDigest": { "$ref": "#/$defs/digest" },
    "gitTreeSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/file" }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/verification" }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "path",
        "operation",
        "beforeDigest",
        "afterDigest",
        "bytes",
        "mode"
      ],
      "properties": {
        "slot": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
        "path": { "type": "string", "minLength": 1 },
        "operation": { "enum": ["create", "modify"] },
        "beforeDigest": {
          "anyOf": [
            { "$ref": "#/$defs/digest" },
            { "type": "null" }
          ]
        },
        "afterDigest": { "$ref": "#/$defs/digest" },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mode": { "const": "100644" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commandId", "stdoutDigest", "stderrDigest"],
      "properties": {
        "commandId": { "type": "string", "minLength": 1 },
        "stdoutDigest": { "$ref": "#/$defs/digest" },
        "stderrDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "value"],
      "properties": {
        "algorithm": { "type": "string", "minLength": 1, "maxLength": 64 },
        "keyId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "value": { "type": "string", "minLength": 1, "maxLength": 16384 }
      }
    }
  }
}
