{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-framework.github.com/schemas/v1alpha1/policy.schema.json",
  "title": "Control policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "version", "actorRules", "independentGates", "prohibitedEffects", "ceilings"],
  "properties": {
    "apiVersion": { "const": "agentic-framework.github.com/v1alpha1" },
    "kind": { "const": "ControlPolicy" },
    "version": { "const": "1.0.0" },
    "actorRules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actorClass", "requiredRoles", "human"],
        "properties": {
          "actorClass": { "enum": ["requester", "reviewer", "maintainer", "administrator", "system", "policy"] },
          "requiredRoles": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "human": { "type": "boolean" }
        }
      }
    },
    "independentGates": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "prohibitedEffects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["approve", "merge", "deploy", "publish", "production-mutation", "crm-mutation", "erp-mutation", "payment", "license-change", "visibility-change"] }
    },
    "ceilings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["depthProfile", "riskClass", "privacyClass", "maxCalls", "maxCostUnits", "maxLoops", "maxRetries", "maxParallel"],
      "properties": {
        "depthProfile": { "enum": ["D0", "D1", "D2", "D3"] },
        "riskClass": { "enum": ["low", "moderate", "high", "critical"] },
        "privacyClass": { "enum": ["public", "internal", "confidential", "restricted"] },
        "maxCalls": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "maxCostUnits": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "maxLoops": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "maxRetries": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "maxParallel": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    }
  }
}
