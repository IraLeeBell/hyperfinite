{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-framework.github.com/schemas/v1alpha1/technical-identity-inventory.schema.json",
  "title": "Hyperfinite technical identity inventory evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "scopes"],
  "properties": {
    "kind": { "const": "TechnicalIdentityInventoryEvidence" },
    "schemaVersion": { "const": "1.0.0" },
    "scopes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authoritative-repository",
        "control-plane-core",
        "demo-portfolio"
      ],
      "properties": {
        "authoritative-repository": { "$ref": "#/$defs/scopeEvidence" },
        "control-plane-core": { "$ref": "#/$defs/scopeEvidence" },
        "demo-portfolio": { "$ref": "#/$defs/scopeEvidence" }
      }
    }
  },
  "$defs": {
    "scopeEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventoryFiles",
        "inventoryMatchingLines",
        "inventoryOccurrences",
        "inventoryDigest"
      ],
      "properties": {
        "inventoryFiles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "inventoryMatchingLines": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "inventoryOccurrences": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "inventoryDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
