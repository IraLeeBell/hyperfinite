{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-framework.github.com/schemas/v1alpha1/github-project-admin-snapshot.schema.json",
  "title": "Fresh exact-target GitHub Project administrator snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observedAt",
    "owner",
    "repository",
    "project",
    "linkedRepositories",
    "itemCount",
    "items",
    "views",
    "fields"
  ],
  "properties": {
    "observedAt": { "type": "string", "format": "date-time" },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "login", "nodeId"],
      "properties": {
        "type": { "const": "organization" },
        "login": { "type": "string", "minLength": 1 },
        "nodeId": { "type": "string", "minLength": 1 }
      }
    },
    "repository": { "$ref": "#/$defs/repository" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "nodeId",
        "title",
        "shortDescription",
        "readme",
        "public",
        "closed"
      ],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "nodeId": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "shortDescription": { "type": ["string", "null"], "maxLength": 256 },
        "readme": { "type": ["string", "null"], "maxLength": 65536 },
        "public": { "type": "boolean" },
        "closed": { "type": "boolean" }
      }
    },
    "linkedRepositories": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/repository" }
    },
    "itemCount": { "type": "integer", "minimum": 0 },
    "items": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nodeId",
          "contentNodeId",
          "title",
          "contentType",
          "fieldValues"
        ],
        "properties": {
          "nodeId": { "type": "string", "minLength": 1 },
          "contentNodeId": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "contentType": { "enum": ["issue", "draft"] },
          "fieldValues": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["fieldName", "dataType", "value"],
              "properties": {
                "fieldName": { "type": "string", "minLength": 1 },
                "dataType": {
                  "enum": ["NUMBER", "SINGLE_SELECT", "TEXT"]
                },
                "value": {
                  "anyOf": [
                    { "type": "string" },
                    { "type": "number" },
                    { "type": "null" }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "views": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nodeId",
          "name",
          "layout",
          "visibleFieldNames",
          "groupByFieldNames"
        ],
        "properties": {
          "nodeId": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "layout": { "type": "string", "minLength": 1 },
          "visibleFieldNames": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "groupByFieldNames": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "fields": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nodeId", "name", "dataType", "options"],
        "properties": {
          "nodeId": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "dataType": { "type": "string", "minLength": 1 },
          "options": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["nodeId", "name", "color", "description"],
              "properties": {
                "nodeId": { "type": "string", "minLength": 1 },
                "name": { "type": "string", "minLength": 1 },
                "color": { "type": "string", "minLength": 1 },
                "description": { "type": "string" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fullName", "nodeId"],
      "properties": {
        "fullName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "nodeId": { "type": "string", "minLength": 1 }
      }
    }
  }
}
