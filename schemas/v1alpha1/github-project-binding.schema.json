{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-framework.github.com/schemas/v1alpha1/github-project-binding.schema.json",
  "title": "Validated GitHub Project binding",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "schemaVersion", "projectSchemaDigest", "owner", "installation", "project", "fields", "validatedAt"],
  "properties": {
    "apiVersion": { "const": "agentic-framework.github.com/v1alpha1" },
    "kind": { "const": "GitHubProjectBinding" },
    "schemaVersion": { "const": "1.0.0" },
    "projectSchemaDigest": { "$ref": "#/$defs/digest" },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "login", "nodeId"],
      "properties": {
        "type": { "enum": ["organization", "user"] },
        "login": { "type": "string", "minLength": 1 },
        "nodeId": { "type": "string", "minLength": 1 }
      }
    },
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "accountNodeId"],
      "properties": {
        "id": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "accountNodeId": { "type": "string", "minLength": 1 }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "nodeId", "title"],
      "properties": {
        "number": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "nodeId": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 }
      }
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "nodeId", "name", "dataType", "options"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
          "nodeId": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "dataType": { "enum": ["DATE", "ITERATION", "NUMBER", "SINGLE_SELECT", "TEXT"] },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "nodeId", "name"],
              "properties": {
                "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
                "nodeId": { "type": "string", "minLength": 1 },
                "name": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "validatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
