{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-framework.github.com/schemas/v1alpha1/target-free-patch.schema.json",
  "title": "Target-Free Implementation Patch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "summary", "changes"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "summary": { "type": "string", "minLength": 1 },
    "changes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot", "content"],
        "properties": {
          "slot": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "content": { "type": "string" }
        }
      }
    }
  }
}
