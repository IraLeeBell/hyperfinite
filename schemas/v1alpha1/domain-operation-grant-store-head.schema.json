{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-framework.github.com/schemas/v1alpha1/domain-operation-grant-store-head.schema.json",
  "title": "Authenticated domain operation grant store head",
  "type": "object",
  "additionalProperties": false,
  "required": ["purpose", "storeId", "storeSequence", "challenge", "head", "observedAt", "expiresAt", "signature"],
  "oneOf": [
    {
      "properties": {
        "storeSequence": { "const": 0 },
        "head": { "type": "null" }
      },
      "required": ["storeSequence", "head"]
    },
    {
      "properties": {
        "storeSequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "head": { "$ref": "#/$defs/digest" }
      },
      "required": ["storeSequence", "head"]
    }
  ],
  "properties": {
    "purpose": { "const": "domain-operation-grant-store-head" },
    "storeId": { "type": "string", "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$", "maxLength": 128 },
    "storeSequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "challenge": { "$ref": "#/$defs/digest" },
    "head": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
    "observedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyId", "algorithm", "value"],
      "properties": {
        "keyId": { "type": "string", "minLength": 1 },
        "algorithm": { "const": "ed25519" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
