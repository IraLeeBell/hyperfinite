{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-framework.github.com/schemas/v1alpha1/demo-project-profile.schema.json",
  "title": "Autonomous demo Project profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "schemaVersion", "contentDigest", "spec"],
  "properties": {
    "apiVersion": { "const": "agentic-framework.github.com/v1alpha1" },
    "kind": { "const": "DemoProjectProfile" },
    "schemaVersion": { "const": "1.0.0" },
    "contentDigest": {
      "$ref": "https://agentic-framework.github.com/schemas/v1alpha1/demo-contract-common.schema.json#/$defs/digest"
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "demoProjectId",
        "catalogDigest",
        "identityReservationsDigest",
        "title",
        "description",
        "defaultDepthProfile",
        "allowedDepthProfiles",
        "repositoryBindingDigest",
        "projectBindingDigest",
        "workAccordTemplateDigest",
        "journeyDefinitionRef",
        "stageAgentBindingsRef",
        "capabilityShardRef",
        "activationProfileRef",
        "projectionMappingRef"
      ],
      "properties": {
        "demoProjectId": {
          "$ref": "https://agentic-framework.github.com/schemas/v1alpha1/demo-contract-common.schema.json#/$defs/demoProjectId"
        },
        "catalogDigest": {
          "$ref": "https://agentic-framework.github.com/schemas/v1alpha1/demo-contract-common.schema.json#/$defs/digest"
        },
        "identityReservationsDigest": {
          "$ref": "https://agentic-framework.github.com/schemas/v1alpha1/demo-contract-common.schema.json#/$defs/digest"
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 128 },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "defaultDepthProfile": { "enum": ["D0", "D1", "D2", "D3"] },
        "allowedDepthProfiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["D0", "D1", "D2", "D3"] }
        },
        "repositoryBindingDigest": {
          "$ref": "https://agentic-framework.github.com/schemas/v1alpha1/demo-contract-common.schema.json#/$defs/digest"
        },
        "projectBindingDigest": {
          "$ref": "https://agentic-framework.github.com/schemas/v1alpha1/demo-contract-common.schema.json#/$defs/digest"
        },
        "workAccordTemplateDigest": {
          "$ref": "https://agentic-framework.github.com/schemas/v1alpha1/demo-contract-common.schema.json#/$defs/digest"
        },
        "journeyDefinitionRef": {
          "$ref": "https://agentic-framework.github.com/schemas/v1alpha1/demo-contract-common.schema.json#/$defs/reference"
        },
        "stageAgentBindingsRef": {
          "$ref": "https://agentic-framework.github.com/schemas/v1alpha1/demo-contract-common.schema.json#/$defs/reference"
        },
        "capabilityShardRef": {
          "$ref": "https://agentic-framework.github.com/schemas/v1alpha1/demo-contract-common.schema.json#/$defs/reference"
        },
        "activationProfileRef": {
          "$ref": "https://agentic-framework.github.com/schemas/v1alpha1/demo-contract-common.schema.json#/$defs/reference"
        },
        "projectionMappingRef": {
          "$ref": "https://agentic-framework.github.com/schemas/v1alpha1/demo-contract-common.schema.json#/$defs/reference"
        }
      }
    }
  }
}
