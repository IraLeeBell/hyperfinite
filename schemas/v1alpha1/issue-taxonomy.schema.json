{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-framework.github.com/schemas/v1alpha1/issue-taxonomy.schema.json",
  "title": "Issue taxonomy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "schemaVersion",
    "repository",
    "limits",
    "labels",
    "historicalIssues",
    "recognizedTitlePrefixes"
  ],
  "properties": {
    "apiVersion": {
      "const": "agentic-framework.github.com/v1alpha1"
    },
    "kind": {
      "const": "IssueTaxonomy"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fullName",
        "repositoryId",
        "defaultBranch"
      ],
      "properties": {
        "fullName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "maxLength": 201
        },
        "repositoryId": {
          "type": "integer",
          "minimum": 1
        },
        "defaultBranch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxOpenIssues",
        "maxPages"
      ],
      "properties": {
        "maxOpenIssues": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "maxPages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      }
    },
    "labels": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/label"
      }
    },
    "historicalIssues": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issueNumber",
          "class"
        ],
        "properties": {
          "issueNumber": {
            "type": "integer",
            "minimum": 1
          },
          "class": {
            "$ref": "#/$defs/taxonomyClass"
          }
        }
      }
    },
    "recognizedTitlePrefixes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "prefix",
          "class"
        ],
        "properties": {
          "prefix": {
            "type": "string",
            "pattern": "^\\[[A-Za-z][A-Za-z ]*\\] $",
            "maxLength": 80
          },
          "class": {
            "$ref": "#/$defs/taxonomyClass"
          }
        }
      }
    }
  },
  "$defs": {
    "taxonomyClass": {
      "type": "string",
      "enum": [
        "customer-evaluation",
        "maintainer-development",
        "synthetic-demo"
      ]
    },
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "name",
        "color",
        "description"
      ],
      "properties": {
        "class": {
          "$ref": "#/$defs/taxonomyClass"
        },
        "name": {
          "type": "string",
          "enum": [
            "type: customer-evaluation",
            "type: maintainer-development",
            "type: synthetic-demo"
          ]
        },
        "color": {
          "type": "string",
          "pattern": "^[0-9A-F]{6}$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    }
  }
}
