{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-framework.github.com/schemas/v1alpha1/github-project-schema.schema.json",
  "title": "Declarative GitHub Project schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "owner", "project", "fields", "projections"],
  "properties": {
    "apiVersion": { "const": "agentic-framework.github.com/v1alpha1" },
    "kind": { "const": "GitHubProjectSchema" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
        "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" }
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "login"],
      "properties": {
        "type": { "enum": ["organization", "user"] },
        "login": { "type": "string", "minLength": 1 }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "shortDescription": { "type": "string", "maxLength": 256 }
      }
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "name", "dataType", "required", "options"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
          "name": { "type": "string", "minLength": 1 },
          "dataType": { "enum": ["DATE", "ITERATION", "NUMBER", "SINGLE_SELECT", "TEXT"] },
          "required": { "type": "boolean" },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "name"],
              "properties": {
                "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
                "name": { "type": "string", "minLength": 1 },
                "description": { "type": "string", "maxLength": 256 },
                "color": { "enum": ["GRAY", "BLUE", "GREEN", "YELLOW", "ORANGE", "RED", "PINK", "PURPLE"] }
              }
            }
          }
        }
      }
    },
    "projections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot", "fieldKey"],
        "properties": {
          "slot": {
            "enum": [
              "stage",
              "journey-stage",
              "demo-project-profile",
              "depth-profile",
              "domain-pack",
              "gate-status",
              "contract-revision",
              "last-receipt",
              "attention",
              "target-repository",
              "run-attempt",
              "current-draft-pr",
              "current-stage-agent",
              "stage-interaction",
              "agent-selection-status"
            ]
          },
          "fieldKey": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
          "source": {
            "enum": [
              "kernel-snapshot",
              "signed-stage-receipt",
              "project-profile",
              "work-accord",
              "trusted-binding",
              "demo-run-state",
              "stage-agent-binding-set",
              "stage-agent-selection"
            ]
          },
          "displayOnly": { "type": "boolean" },
          "writeOrder": { "type": "integer", "minimum": 1, "maximum": 14 }
        }
      }
    }
  }
}
