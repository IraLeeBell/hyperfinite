{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-framework.github.com/schemas/v1alpha1/domain-packs/business-operations/process-map.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "artifactType", "proposalOnly", "sourceDigests", "upstreamArtifactDigests", "data"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" }, "artifactType": { "const": "process-map" }, "proposalOnly": { "const": true },
    "sourceDigests": { "$ref": "#/$defs/digests" }, "upstreamArtifactDigests": { "$ref": "#/$defs/digests" },
    "data": { "type": "object", "additionalProperties": false, "required": ["nodes", "edges", "controls", "irreversibleBoundaries"], "properties": {
      "nodes": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "pattern": "^step:[a-z0-9-]+$" } },
      "edges": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": { "from": { "type": "string", "pattern": "^step:[a-z0-9-]+$" }, "to": { "type": "string", "pattern": "^step:[a-z0-9-]+$" } } } },
      "controls": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^control:[a-z0-9-]+$" } },
      "irreversibleBoundaries": { "type": "array", "items": { "type": "string", "pattern": "^step:[a-z0-9-]+$" } }
    } }
  },
  "$defs": { "digests": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } } }
}
