{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-framework.github.com/schemas/v1alpha1/domain-packs/business-operations/runbook.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "artifactType", "proposalOnly", "sourceDigests", "upstreamArtifactDigests", "data"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" }, "artifactType": { "const": "runbook" }, "proposalOnly": { "const": true },
    "sourceDigests": { "$ref": "#/$defs/digests" }, "upstreamArtifactDigests": { "$ref": "#/$defs/digests" },
    "data": { "type": "object", "additionalProperties": false, "required": ["simulationOnly", "steps"], "properties": {
      "simulationOnly": { "const": true },
      "steps": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["stepId", "description", "expectedEvidence"], "properties": {
        "stepId": { "type": "string", "pattern": "^simulation:[a-z0-9-]+$" }, "description": { "type": "string", "minLength": 1 }, "expectedEvidence": { "type": "string", "minLength": 1 }
      } } }
    } }
  },
  "$defs": { "digests": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } } }
}
