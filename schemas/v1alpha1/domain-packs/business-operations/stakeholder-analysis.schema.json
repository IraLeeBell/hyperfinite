{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-framework.github.com/schemas/v1alpha1/domain-packs/business-operations/stakeholder-analysis.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "artifactType", "proposalOnly", "sourceDigests", "upstreamArtifactDigests", "data"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" }, "artifactType": { "const": "stakeholder-analysis" }, "proposalOnly": { "const": true },
    "sourceDigests": { "$ref": "#/$defs/digests" }, "upstreamArtifactDigests": { "$ref": "#/$defs/digests" },
    "data": { "type": "object", "additionalProperties": false, "required": ["roles", "omissions"], "properties": {
      "roles": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["roleId", "interest", "authorityStatus"], "properties": {
        "roleId": { "type": "string", "pattern": "^role:[a-z0-9-]+$" }, "interest": { "type": "string", "minLength": 1 }, "authorityStatus": { "const": "unverified" }
      } } },
      "omissions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
    } }
  },
  "$defs": { "digests": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } } }
}
