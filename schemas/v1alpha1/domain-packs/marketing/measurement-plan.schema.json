{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-framework.github.com/schemas/v1alpha1/domain-packs/marketing/measurement-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactType", "proposalOnly", "sourceDigests", "upstreamArtifactDigests", "data"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "artifactType": { "const": "measurement-plan" },
    "proposalOnly": { "const": true },
    "sourceDigests": { "$ref": "#/$defs/digests" },
    "upstreamArtifactDigests": { "$ref": "#/$defs/digests" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metricDefinitions"],
      "properties": {
        "metricDefinitions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["metricId", "numerator", "denominator", "windowDays", "privacyFloor", "lineageEvidenceDigest"],
            "properties": {
              "metricId": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
              "numerator": { "type": "string", "minLength": 1 },
              "denominator": { "type": "string", "minLength": 1 },
              "windowDays": { "type": "integer", "minimum": 1, "maximum": 365 },
              "privacyFloor": { "type": "integer", "minimum": 10 },
              "lineageEvidenceDigest": { "$ref": "#/$defs/digest" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "digests": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/digest" } }
  }
}
