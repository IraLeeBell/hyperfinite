{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-framework.github.com/schemas/v1alpha1/domain-packs/marketing/audience-evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactType", "proposalOnly", "sourceDigests", "upstreamArtifactDigests", "data"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "artifactType": { "const": "audience-evidence" },
    "proposalOnly": { "const": true },
    "sourceDigests": { "$ref": "#/$defs/digests" },
    "upstreamArtifactDigests": { "$ref": "#/$defs/digests" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence"],
      "properties": {
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["digest", "contentDigest", "classification", "locator", "rightsBasis", "retentionDays", "sourceObservedAt", "sourceExpiresAt", "observation", "inference", "counterevidence", "confidence", "embeddedInstructions"],
            "properties": {
              "digest": { "$ref": "#/$defs/digest" },
              "contentDigest": { "$ref": "#/$defs/digest" },
              "classification": { "enum": ["internal", "confidential"] },
              "locator": { "type": "string", "pattern": "^repository:[a-z0-9./_-]+$" },
              "rightsBasis": { "enum": ["original", "approved-license", "internal-authorized"] },
              "retentionDays": { "type": "integer", "minimum": 1, "maximum": 90 },
              "sourceObservedAt": { "$ref": "#/$defs/timestamp" },
              "sourceExpiresAt": { "$ref": "#/$defs/timestamp" },
              "observation": { "type": "string", "minLength": 1 },
              "inference": { "type": "string" },
              "counterevidence": { "type": "array", "items": { "type": "string" } },
              "confidence": { "enum": ["low", "medium", "high"] },
              "embeddedInstructions": { "const": "untrusted-data" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "digests": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/digest" } },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$" }
  }
}
