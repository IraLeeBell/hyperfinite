{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-framework.github.com/schemas/v1alpha1/demo-external-call-assertions.schema.json",
  "title": "Demo External Call Assertions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "schemaVersion",
    "demoProjectId",
    "scope",
    "counters"
  ],
  "properties": {
    "apiVersion": {
      "const": "agentic-framework.github.com/v1alpha1"
    },
    "kind": {
      "const": "DemoExternalCallAssertions"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "demoProjectId": {
      "enum": [
        "app-modernization",
        "feature-delivery",
        "security-dependency-remediation",
        "adaptive-delivery"
      ]
    },
    "scope": {
      "const": "fixture-declared-external-call-assertions"
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "github",
        "network",
        "credentials",
        "paidInference"
      ],
      "properties": {
        "github": {
          "const": 0
        },
        "network": {
          "const": 0
        },
        "credentials": {
          "const": 0
        },
        "paidInference": {
          "const": 0
        }
      }
    }
  }
}
