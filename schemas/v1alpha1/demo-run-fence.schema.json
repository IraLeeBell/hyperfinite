{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-framework.github.com/schemas/v1alpha1/demo-run-fence.schema.json",
  "title": "Autonomous demo cross-workflow run fence",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "schemaVersion", "contentDigest", "spec"],
  "properties": {
    "apiVersion": { "const": "agentic-framework.github.com/v1alpha1" },
    "kind": { "const": "DemoRunFence" },
    "schemaVersion": { "const": "1.0.0" },
    "contentDigest": {
      "$ref": "https://agentic-framework.github.com/schemas/v1alpha1/demo-contract-common.schema.json#/$defs/digest"
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "demoProjectId",
        "repositoryId",
        "workItemNodeId",
        "fenceKey",
        "authorityEpoch",
        "generation",
        "runId",
        "runAttempt",
        "runStateDigest",
        "dispatchDecisionDigest",
        "holderDigest",
        "activationLeaseDigest",
        "previousFenceDigest",
        "status",
        "acquiredAt",
        "expiresAt",
        "releasedAt"
      ],
      "properties": {
        "demoProjectId": {
          "$ref": "https://agentic-framework.github.com/schemas/v1alpha1/demo-contract-common.schema.json#/$defs/demoProjectId"
        },
        "repositoryId": {
          "$ref": "https://agentic-framework.github.com/schemas/v1alpha1/demo-contract-common.schema.json#/$defs/positiveInteger"
        },
        "workItemNodeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "fenceKey": {
          "$ref": "https://agentic-framework.github.com/schemas/v1alpha1/demo-contract-common.schema.json#/$defs/digest"
        },
        "authorityEpoch": {
          "$ref": "https://agentic-framework.github.com/schemas/v1alpha1/demo-contract-common.schema.json#/$defs/positiveInteger"
        },
        "generation": {
          "$ref": "https://agentic-framework.github.com/schemas/v1alpha1/demo-contract-common.schema.json#/$defs/nonNegativeInteger"
        },
        "runId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "runAttempt": {
          "$ref": "https://agentic-framework.github.com/schemas/v1alpha1/demo-contract-common.schema.json#/$defs/positiveInteger"
        },
        "runStateDigest": {
          "$ref": "https://agentic-framework.github.com/schemas/v1alpha1/demo-contract-common.schema.json#/$defs/digest"
        },
        "dispatchDecisionDigest": {
          "$ref": "https://agentic-framework.github.com/schemas/v1alpha1/demo-contract-common.schema.json#/$defs/digest"
        },
        "holderDigest": {
          "$ref": "https://agentic-framework.github.com/schemas/v1alpha1/demo-contract-common.schema.json#/$defs/digest"
        },
        "activationLeaseDigest": {
          "$ref": "https://agentic-framework.github.com/schemas/v1alpha1/demo-contract-common.schema.json#/$defs/digest"
        },
        "previousFenceDigest": {
          "$ref": "https://agentic-framework.github.com/schemas/v1alpha1/demo-contract-common.schema.json#/$defs/nullableDigest"
        },
        "status": { "enum": ["acquired", "released"] },
        "acquiredAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "releasedAt": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
