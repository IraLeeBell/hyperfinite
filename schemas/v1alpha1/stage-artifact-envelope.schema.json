{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-framework.github.com/schemas/v1alpha1/stage-artifact-envelope.schema.json",
  "title": "Autonomous demo stage artifact envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "schemaVersion", "contentDigest", "spec"],
  "properties": {
    "apiVersion": { "const": "agentic-framework.github.com/v1alpha1" },
    "kind": { "const": "StageArtifactEnvelope" },
    "schemaVersion": { "const": "1.0.0" },
    "contentDigest": {
      "$ref": "https://agentic-framework.github.com/schemas/v1alpha1/demo-contract-common.schema.json#/$defs/digest"
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "demoProjectId",
        "stageId",
        "projectProfileDigest",
        "journeyDefinitionDigest",
        "stageAgentBindingsDigest",
        "authorityEpoch",
        "generation",
        "runId",
        "runAttempt",
        "producer",
        "inputDigest",
        "artifact",
        "createdAt"
      ],
      "properties": {
        "demoProjectId": {
          "$ref": "https://agentic-framework.github.com/schemas/v1alpha1/demo-contract-common.schema.json#/$defs/demoProjectId"
        },
        "stageId": {
          "$ref": "https://agentic-framework.github.com/schemas/v1alpha1/demo-contract-common.schema.json#/$defs/identifier"
        },
        "projectProfileDigest": {
          "$ref": "https://agentic-framework.github.com/schemas/v1alpha1/demo-contract-common.schema.json#/$defs/digest"
        },
        "journeyDefinitionDigest": {
          "$ref": "https://agentic-framework.github.com/schemas/v1alpha1/demo-contract-common.schema.json#/$defs/digest"
        },
        "stageAgentBindingsDigest": {
          "$ref": "https://agentic-framework.github.com/schemas/v1alpha1/demo-contract-common.schema.json#/$defs/digest"
        },
        "authorityEpoch": {
          "$ref": "https://agentic-framework.github.com/schemas/v1alpha1/demo-contract-common.schema.json#/$defs/positiveInteger"
        },
        "generation": {
          "$ref": "https://agentic-framework.github.com/schemas/v1alpha1/demo-contract-common.schema.json#/$defs/nonNegativeInteger"
        },
        "runId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "runAttempt": {
          "$ref": "https://agentic-framework.github.com/schemas/v1alpha1/demo-contract-common.schema.json#/$defs/positiveInteger"
        },
        "producer": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "agentId",
                "capabilityId",
                "workflowId"
              ],
              "properties": {
                "kind": { "const": "model" },
                "agentId": {
                  "$ref": "https://agentic-framework.github.com/schemas/v1alpha1/demo-contract-common.schema.json#/$defs/identifier"
                },
                "capabilityId": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*@[0-9]+\\.[0-9]+\\.[0-9]+$"
                },
                "workflowId": {
                  "$ref": "https://agentic-framework.github.com/schemas/v1alpha1/demo-contract-common.schema.json#/$defs/identifier"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "agentId",
                "capabilityId",
                "workflowId"
              ],
              "properties": {
                "kind": { "enum": ["deterministic", "human"] },
                "agentId": { "type": "null" },
                "capabilityId": { "type": "null" },
                "workflowId": { "type": "null" }
              }
            }
          ]
        },
        "inputDigest": {
          "$ref": "https://agentic-framework.github.com/schemas/v1alpha1/demo-contract-common.schema.json#/$defs/digest"
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "schemaVersion",
            "mediaType",
            "byteLength",
            "contentDigest"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9]{0,127}$"
            },
            "schemaVersion": { "const": "1.0.0" },
            "mediaType": {
              "enum": ["application/json", "text/markdown"]
            },
            "byteLength": {
              "$ref": "https://agentic-framework.github.com/schemas/v1alpha1/demo-contract-common.schema.json#/$defs/positiveInteger"
            },
            "contentDigest": {
              "$ref": "https://agentic-framework.github.com/schemas/v1alpha1/demo-contract-common.schema.json#/$defs/digest"
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
