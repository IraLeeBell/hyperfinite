{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-framework.github.com/schemas/v1alpha1/copilot-runtime-authorization.schema.json",
  "title": "Redeemed Copilot Runtime Authorization",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "schemaVersion", "authorizationDigest", "candidateDigest", "inputDigest", "stateDigest", "policyDigest", "kernelPolicyDigest", "bindingDigest", "kernelBindingDigest", "workAccordSourceDigest", "repositoryId", "repositoryFullName", "workItemKind", "workItemNumber", "workItemNodeId", "projectNodeId", "projectItemNodeId", "kernelReceiptDigest", "routeId", "phase", "role", "capability", "workflowId", "workflowRef", "workflowSha", "runId", "runAttempt", "eventName", "eventAction", "actorId", "actorLogin", "activationLeaseDigest", "activationNonce", "reservedAiCredits", "remainingAiCreditsBefore", "remainingAiCreditsAfter", "contractRevision", "contractDigest", "currentHead", "executionContext", "outputSchema", "stateCommentId", "stateCommentUpdatedAt", "stateCollectionEtag", "stateRevoked", "leaseRevoked", "projectBindingVerified", "stateCheckedAt", "leaseCheckedAt", "redemptionKey", "casResult", "ledgerVersion", "ledgerHeadBefore", "ledgerHeadAfter", "redeemedAt", "expiresAt", "redeemerServiceId", "signature"],
  "properties": {
    "apiVersion": { "const": "agentic-framework.github.com/v1alpha1" },
    "kind": { "const": "CopilotRuntimeAuthorization" },
    "schemaVersion": { "const": "2.0.0" },
    "authorizationDigest": { "$ref": "#/$defs/digest" },
    "candidateDigest": { "$ref": "#/$defs/digest" },
    "inputDigest": { "$ref": "#/$defs/digest" },
    "stateDigest": { "$ref": "#/$defs/digest" },
    "policyDigest": { "$ref": "#/$defs/digest" },
    "kernelPolicyDigest": { "$ref": "#/$defs/digest" },
    "bindingDigest": { "$ref": "#/$defs/digest" },
    "kernelBindingDigest": { "$ref": "#/$defs/digest" },
    "workAccordSourceDigest": { "$ref": "#/$defs/digest" },
    "repositoryId": { "$ref": "#/$defs/id" },
    "repositoryFullName": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "workItemKind": { "enum": ["issue", "pull-request"] },
    "workItemNumber": { "$ref": "#/$defs/id" },
    "workItemNodeId": { "type": "string", "minLength": 1 },
    "projectNodeId": { "type": "string", "minLength": 1 },
    "projectItemNodeId": { "type": "string", "minLength": 1 },
    "kernelReceiptDigest": { "$ref": "#/$defs/digest" },
    "routeId": { "type": "string", "minLength": 1 },
    "phase": { "enum": ["framing", "execution", "verification"] },
    "role": { "enum": ["framer", "executor", "reviewer"] },
    "capability": { "type": "string", "pattern": "^[a-z0-9.-]+@[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "workflowId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,127}$" },
    "workflowRef": { "type": "string", "minLength": 1 },
    "workflowSha": { "$ref": "#/$defs/sha" },
    "runId": { "$ref": "#/$defs/id" },
    "runAttempt": { "$ref": "#/$defs/id" },
    "eventName": { "type": "string", "minLength": 1 },
    "eventAction": { "type": "string", "minLength": 1 },
    "actorId": { "$ref": "#/$defs/id" },
    "actorLogin": { "type": "string", "minLength": 1 },
    "activationLeaseDigest": { "$ref": "#/$defs/digest" },
    "activationNonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]{32,128}$" },
    "reservedAiCredits": { "$ref": "#/$defs/nonNegative" },
    "remainingAiCreditsBefore": { "$ref": "#/$defs/nonNegative" },
    "remainingAiCreditsAfter": { "$ref": "#/$defs/nonNegative" },
    "contractRevision": { "$ref": "#/$defs/id" },
    "contractDigest": { "$ref": "#/$defs/digest" },
    "currentHead": { "$ref": "#/$defs/nullableSha" },
    "executionContext": { "$ref": "#/$defs/nullableExecutionContext" },
    "outputSchema": { "enum": ["GitHubSafeOutput@1.0.0", "TargetFreePatch@1.0.0"] },
    "stateCommentId": { "$ref": "#/$defs/id" },
    "stateCommentUpdatedAt": { "type": "string", "format": "date-time" },
    "stateCollectionEtag": { "type": "string", "minLength": 1 },
    "stateRevoked": { "const": false },
    "leaseRevoked": { "const": false },
    "projectBindingVerified": { "const": true },
    "stateCheckedAt": { "type": "string", "format": "date-time" },
    "leaseCheckedAt": { "type": "string", "format": "date-time" },
    "redemptionKey": { "$ref": "#/$defs/digest" },
    "casResult": { "const": "appended" },
    "ledgerVersion": { "$ref": "#/$defs/id" },
    "ledgerHeadBefore": { "$ref": "#/$defs/nullableDigest" },
    "ledgerHeadAfter": { "$ref": "#/$defs/digest" },
    "redeemedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "redeemerServiceId": { "type": "string", "minLength": 1 },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "value"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "keyId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]+={0,2}$",
          "minLength": 4,
          "maxLength": 1024
        }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "nullableDigest": {
      "oneOf": [
        { "$ref": "#/$defs/digest" },
        { "type": "null" }
      ]
    },
    "sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "nullableSha": {
      "oneOf": [
        { "$ref": "#/$defs/sha" },
        { "type": "null" }
      ]
    },
    "nullableExecutionContext": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "planningArtifact", "planningArtifactDigest", "canonicalWorkAccord", "canonicalExecutionGrant", "executionGrantDigest", "patchSchema"],
          "properties": {
            "schemaVersion": { "const": "1.0.0" },
            "planningArtifact": {
              "type": "object",
              "additionalProperties": false,
              "required": ["schemaVersion", "steps", "targetSlots", "verificationIds"],
              "properties": {
                "schemaVersion": { "const": "1.0.0" },
                "steps": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "targetSlots": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" } },
                "verificationIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
              }
            },
            "planningArtifactDigest": { "$ref": "#/$defs/digest" },
            "canonicalWorkAccord": { "type": "string", "minLength": 2 },
            "canonicalExecutionGrant": { "type": "string", "minLength": 2 },
            "executionGrantDigest": { "$ref": "#/$defs/digest" },
            "patchSchema": { "const": "TargetFreePatch@1.0.0" }
          }
        }
      ]
    },
    "id": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "nonNegative": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
  }
}
